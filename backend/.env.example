# Base de données — ?sslmode=require est OBLIGATOIRE pour Supabase/Render
DATABASE_URL="postgresql://user:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://user:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_SERVICE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Serveur — Render injecte process.env.PORT automatiquement, on écoute sur 0.0.0.0
PORT=10000
NODE_ENV=development
HOST=0.0.0.0

# JWT (optionnel, car Supabase gère déjà les tokens)
JWT_SECRET="votre_secret_jwt"

# CinetPay (paiements)
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
CINETPAY_SECRET_KEY=""

# Frontend URL (Vercel en production)
FRONTEND_URL="http://localhost:5173"
FRONTEND_URL_PROD="https://soubremarket.vercel.app"

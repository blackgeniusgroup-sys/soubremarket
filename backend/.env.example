# ============================================================
# SOUBREMARKET — BACKEND .ENV.EXAMPLE
# Copiez ce fichier vers `.env` et remplissez les valeurs.
# ============================================================

# ─── SUPABASE ────────────────────────────────────────────────
# URL de votre projet Supabase
SUPABASE_URL=https://votre-projet.supabase.co

# ⚠️ CLÉ ANON (publique) — À UTILISER pour les opérations RLS
# Disponible dans : Dashboard Supabase → Settings → API Keys → anon public
# Obligatoire pour les routes sécurisées (zones-secure, notifications...)
# Ne JAMAIS mettre la clé service_role ici pour les requêtes métier.
SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ CLÉ SERVICE_ROLE — RÉSERVÉE UNIQUEMENT À L'API AUTH
# Utilisée UNIQUEMENT pour :
#   - signInWithPassword, refreshSession, admin.createUser (API Auth)
#   - admin.signOut, storage upload (aucune table métier)
# NE PAS l'utiliser pour des requêtes .from('table').select()...
#   car elle contournerait TOUTES les politiques RLS (faille critique).
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# ─── BASE DE DONNÉES (Prisma) ──────────────────────────────
# URL de connexion directe (pooler ou direct selon votre setup)
DATABASE_URL=postgresql://postgres:password@db.votre-projet.supabase.co:5432/postgres

# URL directe (si vous utilisez Supabase Pooler avec transaction mode)
DIRECT_URL=postgresql://postgres:password@db.votre-projet.supabase.co:5432/postgres

# ─── SERVEUR ───────────────────────────────────────────────
# Port dynamique Render (laissez vide en local)
PORT=10000
NODE_ENV=development

# Origines CORS autorisées (séparées par des virgules si plusieurs)
CORS_ORIGINS=http://localhost:5173,https://soubremarket.vercel.app